# KHÔNG BAO GIỜ commit key
.env
.env.*
*.key
secrets*
# Không commit data pack của khoá (quy định bảo mật — README mục "Bảo mật dữ liệu")
data/
*.csv
__pycache__/
.DS_Store
node_modules/

# nhưng golden set trong eval/ thì vẫn commit
!eval/*.csv

# thư mục làm việc riêng của An — không đẩy lên GitHub
AN/

# bot
codebase/bot/node_modules/
codebase/bot/.env
codebase/bot/data/

# trace lời gọi LLM thì PHẢI commit (rubric R5 đòi log/trace trong repo)
!eval/traces/
!eval/traces/*.jsonl

# Tài liệu nguồn của khoá — không commit lên repo public
*.pdf
# Trừ slide nộp CP5 — nhóm tự làm, BTC đòi nằm ở gốc repo
!demo-slides.pdf

# Phiếu chấm tay chứa nguyên văn tin nhắn từ data pack của khoá — không commit.
